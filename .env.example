# Copy this file to .env and fill in a key.

# --- Option A: OpenCode Zen, DeepSeek (or any non-Claude Zen model) -------
# Zen serves these on its OpenAI-compatible /chat/completions endpoint.
LLM_PROVIDER=openai
LLM_BASE_URL=https://opencode.ai/zen/v1
LLM_API_KEY=<your OpenCode Zen key>
LLM_MODEL=deepseek-v4-flash

# --- Option B: OpenCode Zen, Claude models --------------------------------
# Zen serves these on its Anthropic-compatible /messages endpoint.
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=https://opencode.ai/zen
# LLM_API_KEY=<your OpenCode Zen key>
# LLM_MODEL=claude-opus-5
# STRUCTURED_OUTPUT=off        # set if the gateway rejects output_config

# --- Option C: Anthropic API directly -------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional -------------------------------------------------------------
# LLM_EFFORT=low               # anthropic provider only
# PORT=3000
