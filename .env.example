# Copy this file to .env and fill in a key.

# --- OpenCode Go (subscription tier) --------------------------------------
# Note the /go/ in the path. This is the tier the lunch-uncle project uses.
# The other Zen path (/zen/v1) bills a prepaid credit wallet and returns
# "401 Insufficient balance" for a Go subscription key.
LLM_PROVIDER=openai
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=<your OpenCode key>
LLM_MODEL=deepseek-v4-flash

# --- OpenCode Zen, pay-as-you-go credits ----------------------------------
# LLM_BASE_URL=https://opencode.ai/zen/v1     # needs a positive credit balance

# --- Anthropic API directly -----------------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional -------------------------------------------------------------
# LLM_EFFORT=low               # anthropic provider only
# STRUCTURED_OUTPUT=off        # anthropic provider only, for gateways
# PORT=3000
