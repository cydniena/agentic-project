# Copy this file to .env and fill in a key.

# --- Option A: Anthropic API directly -------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- Option B: OpenCode Zen (Anthropic-compatible gateway) ----------------
# Same SDK, same model IDs - only the base URL and the key change.
# ANTHROPIC_BASE_URL=https://opencode.ai/zen
# ANTHROPIC_API_KEY=<your OpenCode Zen key>        # sent as the x-api-key header
# ANTHROPIC_AUTH_TOKEN=<your OpenCode Zen key>     # use this INSTEAD if Zen wants: Authorization: Bearer
# STRUCTURED_OUTPUT=off                            # set if the gateway rejects output_config

# --- Optional -------------------------------------------------------------
# LLM_MODEL=claude-opus-5
# LLM_EFFORT=low
# PORT=3000
